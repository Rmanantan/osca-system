```css
/* =========================================
   CCS / OSCA SENIOR CITIZEN SYSTEM
   Main Stylesheet
   ========================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --navy: #173b57;
    --blue: #285b7d;
    --light-blue: #eaf3f8;
    --background: #f4f6f9;
    --white: #ffffff;
    --text: #263238;
    --muted: #6b7280;
    --border: #dfe5ea;

    --green: #2e7d32;
    --green-bg: #e8f5e9;

    --orange: #ef6c00;
    --orange-bg: #fff3e0;

    --red: #c62828;
    --red-bg: #ffebee;

    --yellow: #f9a825;
    --yellow-bg: #fff8e1;

    --shadow: 0 2px 10px rgba(0, 0, 0, 0.08);
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: var(--background);
    color: var(--text);
    line-height: 1.5;
}

/* =========================================
   SIDEBAR
   ========================================= */

.sidebar {
    position: fixed;
    left: 0;
    top: 0;
    width: 250px;
    height: 100vh;
    background: var(--navy);
    color: var(--white);
    z-index: 1000;
    overflow-y: auto;
}

.sidebar-header {
    padding: 22px 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
}

.sidebar-header h2 {
    font-size: 20px;
    margin-bottom: 4px;
}

.sidebar-header p {
    font-size: 12px;
    opacity: 0.75;
}

.sidebar-menu {
    list-style: none;
    padding: 15px 10px;
}

.sidebar-menu li {
    margin-bottom: 5px;
}

.sidebar-menu a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    color: #dbe8f0;
    text-decoration: none;
    border-radius: 7px;
    font-size: 14px;
    transition: 0.2s ease;
}

.sidebar-menu a:hover,
.sidebar-menu a.active {
    background: var(--blue);
    color: var(--white);
}

.sidebar-menu .icon {
    width: 22px;
    text-align: center;
    font-size: 17px;
}

/* =========================================
   MAIN CONTENT
   ========================================= */

.main-content {
    margin-left: 250px;
    min-height: 100vh;
}

/* =========================================
   TOPBAR
   ========================================= */

.topbar {
    height: 70px;
    background: var(--white);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 30px;
    position: sticky;
    top: 0;
    z-index: 900;
}

.topbar h1 {
    font-size: 22px;
    color: var(--navy);
}

.topbar-right {
    display: flex;
    align-items: center;
    gap: 15px;
}

.user-info {
    text-align: right;
}

.user-info strong {
    display: block;
    font-size: 14px;
}

.user-info span {
    display: block;
    color: var(--muted);
    font-size: 12px;
}

.user-avatar {
    width: 40px;
    height: 40px;
    background: var(--blue);
    color: var(--white);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
}

/* =========================================
   PAGE CONTAINER
   ========================================= */

.page-container {
    padding: 30px;
}

.page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 25px;
    gap: 15px;
}

.page-header h2 {
    color: var(--navy);
    font-size: 25px;
}

.page-header p {
    color: var(--muted);
    font-size: 14px;
    margin-top: 4px;
}

/* =========================================
   BUTTONS
   ========================================= */

.btn {
    border: none;
    border-radius: 6px;
    padding: 10px 16px;
    font-size: 14px;
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    transition: 0.2s ease;
}

.btn-primary {
    background: var(--blue);
    color: var(--white);
}

.btn-primary:hover {
    background: var(--navy);
}

.btn-success {
    background: var(--green);
    color: var(--white);
}

.btn-warning {
    background: var(--orange);
    color: var(--white);
}

.btn-danger {
    background: var(--red);
    color: var(--white);
}

.btn-secondary {
    background: #e5e7eb;
    color: #374151;
}

.btn-sm {
    padding: 6px 10px;
    font-size: 12px;
}

/* =========================================
   STAT CARDS
   ========================================= */

.stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin-bottom: 25px;
}

.stat-card {
    background: var(--white);
    border-radius: 8px;
    padding: 20px;
    box-shadow: var(--shadow);
    border-left: 4px solid var(--blue);
}

.stat-card.green {
    border-left-color: var(--green);
}

.stat-card.orange {
    border-left-color: var(--orange);
}

.stat-card.red {
    border-left-color: var(--red);
}

.stat-card.yellow {
    border-left-color: var(--yellow);
}

.stat-card h3 {
    color: var(--muted);
    font-size: 13px;
    font-weight: normal;
    margin-bottom: 8px;
}

.stat-card .number {
    font-size: 28px;
    font-weight: bold;
    color: var(--navy);
}

.stat-card p {
    color: var(--muted);
    font-size: 12px;
    margin-top: 5px;
}

/* =========================================
   CARDS
   ========================================= */

.card {
    background: var(--white);
    border-radius: 8px;
    box-shadow: var(--shadow);
    margin-bottom: 25px;
}

.card-header {
    padding: 18px 20px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.card-header h3 {
    color: var(--navy);
    font-size: 17px;
}

.card-body {
    padding: 20px;
}

/* =========================================
   FILTERS
   ========================================= */

.filters {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 20px;
}

.search-box {
    position: relative;
    flex: 1;
    min-width: 220px;
}

.search-box input {
    width: 100%;
    padding: 10px 12px 10px 38px;
    border: 1px solid var(--border);
    border-radius: 6px;
    outline: none;
}

.search-box span {
    position: absolute;
    left: 12px;
    top: 9px;
    color: var(--muted);
}

.filters select,
.filters input {
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--white);
    color: var(--text);
    outline: none;
}

.filters select:focus,
.filters input:focus,
.search-box input:focus {
    border-color: var(--blue);
}

/* =========================================
   TABLE
   ========================================= */

.table-container {
    width: 100%;
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
    min-width: 750px;
}

thead {
    background: #f1f5f8;
}

th {
    text-align: left;
    padding: 13px 14px;
    font-size: 12px;
    color: #4b5563;
    text-transform: uppercase;
    letter-spacing: 0.3px;
}

td {
    padding: 14px;
    border-top: 1px solid var(--border);
    font-size: 13px;
}

tbody tr:hover {
    background: #f8fafc;
}

/* =========================================
   STATUS BADGES
   ========================================= */

.badge {
    display: inline-block;
    padding: 5px 9px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: bold;
}

.badge-active,
.badge-completed,
.badge-success {
    background: var(--green-bg);
    color: var(--green);
}

.badge-pending {
    background: var(--yellow-bg);
    color: #8a6500;
}

.badge-inactive,
.badge-archived {
    background: #eceff1;
    color: #546e7a;
}

.badge-rejected,
.badge-danger {
    background: var(--red-bg);
    color: var(--red);
}

/* =========================================
   ACTION BUTTONS
   ========================================= */

.action-buttons {
    display: flex;
    gap: 5px;
    flex-wrap: wrap;
}

.action-btn {
    border: 1px solid var(--border);
    background: var(--white);
    color: var(--blue);
    padding: 6px 9px;
    border-radius: 5px;
    cursor: pointer;
    font-size: 12px;
}

.action-btn:hover {
    background: var(--light-blue);
}

.action-btn.delete {
    color: var(--red);
}

.action-btn.edit {
    color: var(--orange);
}

/* =========================================
   FORMS
   ========================================= */

.form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
}

.form-group {
    display: flex;
    flex-direction: column;
}

.form-group.full {
    grid-column: 1 / -1;
}

.form-group label {
    font-size: 13px;
    font-weight: bold;
    margin-bottom: 7px;
    color: #374151;
}

.form-group input,
.form-group select,
.form-group textarea {
    width: 100%;
    padding: 11px 12px;
    border: 1px solid var(--border);
    border-radius: 6px;
    font-family: inherit;
    font-size: 14px;
    outline: none;
}

.form-group textarea {
    min-height: 100px;
    resize: vertical;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
    border-color: var(--blue);
}

/* =========================================
   MODAL
   ========================================= */

.modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 2000;
    align-items: center;
    justify-content: center;
    padding: 20px;
}

.modal.show {
    display: flex;
}

.modal-content {
    width: 100%;
    max-width: 650px;
    max-height: 90vh;
    overflow-y: auto;
    background: var(--white);
    border-radius: 9px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
}

.modal-header {
    padding: 18px 20px;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.modal-header h3 {
    color: var(--navy);
}

.close-modal {
    border: none;
    background: none;
    font-size: 24px;
    cursor: pointer;
    color: var(--muted);
}

.modal-body {
    padding: 20px;
}

.modal-footer {
    padding: 15px 20px;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: flex-end;
    gap: 10px;
}

/* =========================================
   DETAILS
   ========================================= */

.details-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
}

.detail-item {
    padding: 12px;
    background: #f8fafc;
    border-radius: 6px;
}

.detail-item label {
    display: block;
    font-size: 11px;
    color: var(--muted);
    margin-bottom: 4px;
}

.detail-item strong {
    font-size: 14px;
}

/* =========================================
   DASHBOARD / CHART AREA
   ========================================= */

.dashboard-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 20px;
}

.chart-box {
    min-height: 280px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
}

.bar-chart {
    width: 100%;
}

.bar-item {
    margin-bottom: 14px;
}

.bar-label {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    margin-bottom: 5px;
}

.bar-background {
    width: 100%;
    height: 10px;
    background: #e5e7eb;
    border-radius: 10px;
    overflow: hidden;
}

.bar-fill {
    height: 100%;
    background: var(--blue);
    border-radius: 10px;
}

/* =========================================
   DONUT / STATUS
   ========================================= */

.donut-container {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 25px;
}

.donut {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    background: conic-gradient(
        var(--green) 0deg 288deg,
        var(--yellow) 288deg 360deg
    );
    display: flex;
    align-items: center;
    justify-content: center;
}

.donut::after {
    content: "";
    width: 95px;
    height: 95px;
    background: var(--white);
    border-radius: 50%;
}

.legend {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.legend-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
}

.legend-dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--blue);
}

.legend-dot.green {
    background: var(--green);
}

.legend-dot.yellow {
    background: var(--yellow);
}

.legend-dot.red {
    background: var(--red);
}

/* =========================================
   ALERTS
   ========================================= */

.alert {
    padding: 12px 15px;
    border-radius: 6px;
    margin-bottom: 15px;
    font-size: 13px;
}

.alert-info {
    background: var(--light-blue);
    color: var(--navy);
}

.alert-success {
    background: var(--green-bg);
    color: var(--green);
}

.alert-warning {
    background: var(--yellow-bg);
    color: #8a6500;
}

.alert-danger {
    background: var(--red-bg);
    color: var(--red);
}

/* =========================================
   PAGINATION
   ========================================= */

.pagination {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 5px;
    padding: 18px 20px;
}

.pagination button {
    min-width: 34px;
    height: 34px;
    border: 1px solid var(--border);
    background: var(--white);
    border-radius: 5px;
    cursor: pointer;
}

.pagination button:hover,
.pagination button.active {
    background: var(--blue);
    color: var(--white);
    border-color: var(--blue);
}

/* =========================================
   LOGIN PAGE
   ========================================= */

.login-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--background);
    padding: 20px;
}

.login-container {
    width: 100%;
    max-width: 420px;
}

.login-card {
    background: var(--white);
    padding: 35px;
    border-radius: 10px;
    box-shadow: 0 5px 25px rgba(0, 0, 0, 0.1);
}

.login-logo {
    text-align: center;
    margin-bottom: 25px;
}

.login-logo h1 {
    color: var(--navy);
    font-size: 25px;
}

.login-logo p {
    color: var(--muted);
    font-size: 13px;
}

.login-card .form-group {
    margin-bottom: 18px;
}

.login-btn {
    width: 100%;
    padding: 12px;
    margin-top: 5px;
}

/* =========================================
   FOOTER
   ========================================= */

.footer {
    text-align: center;
    padding: 25px;
    color: var(--muted);
    font-size: 12px;
}

/* =========================================
   EMPTY STATE
   ========================================= */

.empty-state {
    text-align: center;
    padding: 45px 20px;
    color: var(--muted);
}

.empty-state .icon {
    font-size: 40px;
    margin-bottom: 10px;
}

.empty-state h3 {
    color: #4b5563;
    margin-bottom: 5px;
}

/* =========================================
   PROFILE
   ========================================= */

.profile-header {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 20px;
}

.profile-avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: var(--blue);
    color: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
    font-weight: bold;
}

.profile-info h2 {
    color: var(--navy);
}

.profile-info p {
    color: var(--muted);
    font-size: 13px;
}

/* =========================================
   QR CODE
   ========================================= */

.qr-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 25px;
}

.qr-code {
    width: 200px;
    height: 200px;
    border: 8px solid var(--white);
    box-shadow: var(--shadow);
    margin-bottom: 15px;
}

/* =========================================
   RESPONSIVE DESIGN
   ========================================= */

@media (max-width: 1100px) {
    .stats-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .dashboard-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 768px) {
    .sidebar {
        width: 70px;
    }

    .sidebar-header {
        text-align: center;
        padding: 18px 5px;
    }

    .sidebar-header h2 {
        font-size: 13px;
    }

    .sidebar-header p {
        display: none;
    }

    .sidebar-menu {
        padding: 10px 7px;
    }

    .sidebar-menu a {
        justify-content: center;
        padding: 12px 5px;
    }

    .sidebar-menu a span:not(.icon) {
        display: none;
    }

    .sidebar-menu .icon {
        font-size: 18px;
    }

    .main-content {
        margin-left: 70px;
    }

    .topbar {
        padding: 0 15px;
    }

    .topbar h1 {
        font-size: 18px;
    }

    .user-info {
        display: none;
    }

    .page-container {
        padding: 20px 15px;
    }

    .page-header {
        flex-direction: column;
        align-items: flex-start;
    }

    .stats-grid {
        grid-template-columns: 1fr;
    }

    .form-grid,
    .details-grid {
        grid-template-columns: 1fr;
    }

    .form-group.full {
        grid-column: auto;
    }

    .filters {
        flex-direction: column;
    }

    .search-box {
        width: 100%;
    }

    .filters select,
    .filters input {
        width: 100%;
    }
}

@media (max-width: 480px) {
    .sidebar {
        width: 55px;
    }

    .main-content {
        margin-left: 55px;
    }

    .topbar {
        height: 60px;
    }

    .topbar h1 {
        font-size: 16px;
    }

    .page-container {
        padding: 15px 10px;
    }

    .stat-card {
        padding: 16px;
    }

    .stat-card .number {
        font-size: 24px;
    }

    .modal {
        padding: 10px;
    }

    .modal-content {
        max-height: 95vh;
    }

    .modal-footer {
        flex-direction: column;
    }

    .modal-footer .btn {
        width: 100%;
    }
}

/* =========================================
   PRINT
   ========================================= */

@media print {
    .sidebar,
    .topbar,
    .btn,
    .filters,
    .action-buttons {
        display: none !important;
    }

    .main-content {
        margin-left: 0;
    }

    .page-container {
        padding: 0;
    }

    .card {
        box-shadow: none;
        border: 1px solid #ddd;
    }
}
```
