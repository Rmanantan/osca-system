/* Mobile Sidebar */
@media (max-width: 768px) {
    .sidebar {
        width: 70px;
        min-width: 70px;
        overflow: visible;
    }

    .sidebar .logo {
        font-size: 0;
        text-align: center;
    }

    .sidebar .logo::before {
        content: "O";
        font-size: 28px;
        font-weight: bold;
    }

    .sidebar .nav-item {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 50px;
        height: 50px;
        margin: 8px auto;
        padding: 0;
    }

    .sidebar .nav-item i,
    .sidebar .nav-item svg {
        display: block !important;
        font-size: 22px;
        width: 22px;
        height: 22px;
    }

    .sidebar .nav-item span {
        display: none;
    }
}
